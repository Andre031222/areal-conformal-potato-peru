# Only reproducible code, district-level data and figures are published.
00-gestion/
01-articulo/

# Datos: se publican solo los agregados distritales; las fuentes crudas (GB) se descargan con data-raw/
data/*
!data/README.md
!data/SOURCES.md
!data/tabla_distrital_2012.csv
!data/ubigeo_2023_a_2012.csv
!data/etiqueta_papa_distrito_2012.csv
!data/clima_pisco_distrito_2012.csv
!data/limites/
data/limites/*
!data/limites/distritos_2012.gpkg

# Figuras: se publica el PNG; PDF y TIFF se regeneran con 03-codigo/05_figuras.R
figuras/*.pdf
figuras/*.tiff

# Resultados pesados: se regeneran con los scripts (y se archivan en Zenodo al publicar)
